{
  "extends": "./tsconfig.json",
  "include": [
    "src/contracts/**/*.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "artifacts"
  }
}