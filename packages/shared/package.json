{
  "name": "@ai-bounties/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules --test dist/**/*.test.js 2>/dev/null || node --import tsx --test src/**/*.test.ts",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@bsv/sdk": "^1.4.21",
    "@noble/hashes": "^1.7.1"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
