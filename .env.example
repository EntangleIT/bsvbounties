# API
AI_BOUNTIES_PORT=8787
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8787
NETWORK=main   # main | test
DATA_DIR=./data

# CORS — web app origin
WEB_ORIGIN=http://localhost:5173

# LLM (Grok first; swap provider later)
LLM_PROVIDER=xai
LLM_MODEL=grok-3
XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: default platform fee basis points (Phase 1 not enforced on-chain)
PLATFORM_FEE_BPS=200

# Auth: demo signatures (sha256 of message:controllerKey). Later: ECDSA.
AUTH_MODE=demo

# When true, claiming a bounty requires a logged-in account
REQUIRE_ACCOUNT_FOR_CLAIM=false

# Phase 4: poster bonds
REQUIRE_POSTER_BOND=false
POSTER_BOND_MIN_SATS=10000
# PLATFORM_ADMIN_SECRET=change-me

# MCP server
AI_BOUNTIES_API_URL=http://localhost:8787
