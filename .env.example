# API
AI_BOUNTIES_PORT=8787
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8787
# BSV network: test (default) | main
NETWORK=test
BSV_NETWORK=test
DATA_DIR=./data

# Escrow: app = P2PKH hold + state machine; scrypt = compiled BountyEscrow covenant
ESCROW_MODE=scrypt

# Testnet deployer WIF (never commit a real key). Fund: https://bsvfaucet.com/ or https://scrypt.io/faucet
# BSV_TESTNET_WIF=

# CORS — web app origin
WEB_ORIGIN=http://localhost:5173

# LLM (Grok first; swap provider later)
LLM_PROVIDER=xai
LLM_MODEL=grok-3
XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Platform fee (basis points) on approve
PLATFORM_FEE_BPS=200
# PLATFORM_FEE_PKH=  # 20-byte hash160 hex for fee output

# Auth: demo signatures (sha256 of message:controllerKey). Later: ECDSA.
AUTH_MODE=demo

# When true, claiming a bounty requires a logged-in account
REQUIRE_ACCOUNT_FOR_CLAIM=false

# Poster bonds
REQUIRE_POSTER_BOND=false
POSTER_BOND_MIN_SATS=10000
# Worker bonds (claim gate)
REQUIRE_WORKER_BOND=false
WORKER_BOND_MIN_SATS=10000
# PLATFORM_ADMIN_SECRET=change-me

# MCP server
AI_BOUNTIES_API_URL=http://localhost:8787

# Cloudflare Worker (npx wrangler secret put XAI_API_KEY) — do not put secrets in wrangler.jsonc
# PUBLIC_URL=https://entangleit.com/bsvbounties
